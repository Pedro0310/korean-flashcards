# Copy to .env and fill in. A hosted Postgres URL (Neon, Supabase, Render, ...) works here too.
DATABASE_URL=postgres://korean_app:password@localhost:5432/korean_flashcards
PORT=3001

# Set in production. NODE_ENV=production makes the sign-in cookie HTTPS-only.
# TRUST_PROXY=1 when the app runs behind the host's proxy (Render, Railway, Fly...),
# so the per-IP request limits see the visitor's address instead of the proxy's.
# NODE_ENV=production
# TRUST_PROXY=1
